---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro"
import Layout from "@/layouts/Layout.astro"
import { Docs } from "@/components/docs"
import { source } from "@/lib/source"
import { buildPageImageUrl, cmsRepository } from "@/lib/shared"

export const prerender = true

export const getStaticPaths = (() => {
  return source.getPages().map((page) => ({
    params: { slug: decodeURI(page.slugs.join("/")) || undefined },
    props: { page },
  }))
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { page } = Astro.props
const { body: Content, toc } = await page.data.load()
const pageTree = await source.serializePageTree(source.getPageTree())
const githubUrl = page.data.source
  ? `${cmsRepository.url}/blob/${cmsRepository.editBranch}/${page.data.source}`
  : cmsRepository.url
---

<Layout
  title={`${page.data.title} | Mostra`}
  description={page.data.description}
  image={buildPageImageUrl(page).url}
>
  <Docs
    client:load
    transition:persist="docs"
    pathname={Astro.url.pathname}
    params={Astro.params}
    tree={pageTree}
    title={page.data.title}
    toc={toc}
    markdownUrl={`${page.url}.md`}
    githubUrl={githubUrl}
  >
    <Content />
  </Docs>
</Layout>
