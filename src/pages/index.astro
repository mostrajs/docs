---
import Layout from "@/layouts/Layout.astro"
import { Home } from "@/components/home"
import { cmsDocsRoute, homeDescription } from "@/lib/shared"

// A placeholder until the landing page is built.
---

<Layout
  title="Mostra | CMS for Medusa.js"
  description={homeDescription}
  image="/og/home.webp"
>
  <Home client:load pathname="/" params={Astro.params}>
    <div class="p-4 flex flex-col items-center justify-center text-center flex-1">
      <h1 class="text-xl font-bold mb-2">Mostra</h1>
      <p class="text-fd-muted-foreground mb-4">CMS for Medusa.js</p>
      <a
        class="text-sm bg-fd-primary text-fd-primary-foreground rounded-full font-medium px-4 py-2.5"
        href={cmsDocsRoute}
      >
        Read the docs
      </a>
    </div>
  </Home>
</Layout>
